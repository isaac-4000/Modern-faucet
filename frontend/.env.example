# Endereço da API (backend Laravel).
# Em desenvolvimento: http://localhost:8000/api
# Em produção: https://api.seudominio.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Chave pública do Cloudflare Turnstile (o captcha).
# Painel: https://dash.cloudflare.com -> Turnstile
# SEM ela, o cadastro e o claim são recusados pelo backend.
VITE_TURNSTILE_SITE_KEY=
